# LLM Provider API Keys
# At least one of these is required

# OpenAI (for embeddings, required for dense/hybrid search)
OPENAI_API_KEY=your_openai_api_key_here

# Kimi/Moonshot (default LLM provider; either key is accepted)
KIMI_API_KEY=your_kimi_api_key_here
# MOONSHOT_API_KEY=your_moonshot_api_key_here

# Alternative providers
# DOUBAO_API_KEY remains supported for existing configurations. ARK_API_KEY is
# also accepted by the shared provider resolver and takes precedence when both
# are set.
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
DOUBAO_API_KEY=your_doubao_api_key_here
# ARK_API_KEY=your_ark_api_key_here
# OpenRouter: usable as an explicit provider, and also a universal fallback -
# if the configured provider's key is missing but OPENROUTER_API_KEY is set,
# the system auto-routes through OpenRouter (model names mapped automatically;
# unknown names remain unchanged instead of silently selecting another model.
# OPENROUTER_MODEL remains a fallback-only compatibility override.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Configuration overrides (optional)
LLM_PROVIDER=kimi
LLM_MODEL=kimi-k3
ROUNDS_PER_CHUNK=20
INDEX_MODE=hybrid
